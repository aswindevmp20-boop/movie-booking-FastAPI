# Database
DATABASE_URL=postgresql+asyncpg://booker:secret@postgres:5432/bookings

# Redis
REDIS_URL=redis://redis:6379/0

# JWT secrets (replace with secure values)
ACCESS_TOKEN_SECRET=replace_access_secret
REFRESH_TOKEN_SECRET=replace_refresh_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App settings
APP_ENV=development
